# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Read-only user used by the API (create it in Neo4j, see docs/contracts.md)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=reader
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
QUERY_TIMEOUT_S=10

# Admin credentials: used by ETL, GDS and benchmark scripts only, never by the API
NEO4J_ADMIN_USER=neo4j
NEO4J_ADMIN_PASSWORD=change-me-too

# Optional: if set, POST /api/ask requires the header X-API-Key
API_KEY=

# NL->Cypher agent: any OpenAI-compatible chat endpoint.
# Local Ollama (free, no key): LLM_API_URL=http://localhost:11434/v1/chat/completions  LLM_MODEL=qwen2.5-coder:7b
# Groq (free key):             LLM_API_URL=https://api.groq.com/openai/v1/chat/completions  LLM_MODEL=llama-3.3-70b-versatile
# With Docker, a local Ollama is at http://host.docker.internal:11434/v1/chat/completions
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

MODEL_PATH=models/tier_classifier.joblib
LOG_LEVEL=INFO
